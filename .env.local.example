# ─── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=1wo_G5EVfT80lUd-2FFi_TVrCQuiXTPrpdVIG1Tr_iuw

# Service account credentials (from the downloaded JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file — keep the -----BEGIN/END----- lines
# Escape newlines as \n if your platform requires it
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Base URL of the n8n instance (used to build webhook + workflow links on Settings page)
N8N_BASE_URL=https://automation.rentingfreedom.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
APP_ENV=development

# ─── Auth (optional simple password protection) ───────────────────────────────
# Set ADMIN_PASSWORD to enable password protection on all routes.
# Leave blank to disable (useful for local dev).
# See README for upgrading to Google OAuth / Clerk.
ADMIN_PASSWORD=
# Required whenever ADMIN_PASSWORD is set. Used only to sign the session
# cookie — never rotate this alongside ADMIN_PASSWORD, since doing so would
# invalidate all active sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXT_PUBLIC_AUTH_ENABLED=false
