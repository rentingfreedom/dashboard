# ─── Google Sheets ──────────────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=1wo_G5EVfT80lUd-2FFi_TVrCQuiXTPrpdVIG1Tr_iuw

# Service account credentials (from the downloaded JSON key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the private_key value from the JSON file — keep the -----BEGIN/END----- lines
# Escape newlines as \n if your platform requires it
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"

# ─── n8n ─────────────────────────────────────────────────────────────────────
# Base URL of the n8n instance (used to build webhook + workflow links on Settings page)
N8N_BASE_URL=https://automation.rentingfreedom.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
APP_ENV=development

# ─── Auth (Clerk) ───────────────────────────────────────────────────────────
# From your Clerk application's API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Stripe Identity ─────────────────────────────────────────────────────────
# From dashboard.stripe.com/apikeys — use test-mode keys until this is ready
# to go live with real prospects.
STRIPE_SECRET_KEY=

# From the webhook endpoint you create at dashboard.stripe.com/webhooks
# (listen for identity.verification_session.verified / requires_input / canceled)
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Shared secret n8n sends as the `x-internal-api-key` header when it calls
# POST /api/identity/create-session. Generate any long random string and put
# the same value in the n8n workflow's HTTP Request node headers.
IDENTITY_SESSION_API_KEY=

# Exact FUB stage label to treat as "don't verify this lead" — defensive,
# secondary check only (the primary guard lives in the n8n workflow itself).
# Confirm the real label with the client; "Rejected" is a placeholder default.
REJECTED_STAGE_LABEL=Rejected

# n8n webhook URL that receives verification results (verified/requires_input/
# canceled) so it can log to FUB and, for failed/flagged sessions, kick off
# the staff notification. Leave unset to skip that hand-off during local dev.
N8N_IDENTITY_RESULT_WEBHOOK_URL=
