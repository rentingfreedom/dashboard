    {
      "parameters": {
        "jsCode": "\nfunction normalize(value) { return String(value ?? \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\"); }\nfunction normalizeAddress(value) { return String(value ?? \"\").toLowerCase().replace(/\\b(apartment|apt|unit|suite|ste)\\b/g, \"\").replace(/\\b(street|st|road|rd|avenue|ave|drive|dr|court|ct|boulevard|blvd|lane|ln|circle|cir|place|pl|terrace|ter)\\b/g, \"\").replace(/[^a-z0-9]/g, \"\"); }\nfunction dedupe(values) { return [...new Set(values.map(v => String(v || \"\").trim()).filter(Boolean))]; }\n\nconst person = $items(\"FUB - Get Person\")[0]?.json?.people?.[0] || {};\nconst sheetRows = $items(\"Google Sheets - Read Properties\").map(i => i.json || {});\n\n// ── TRASH_GATE_MARKER: hard block, independent of allowed_stages ──────────\nif (String(person.stage ?? \"\").trim().toLowerCase() === \"trash\") {\n  return [{ json: { skipped: true, reason: \"stage_trash\", person_id: person.id, person_name: person.name } }];\n}\n\nconst addressCandidates = [];\nif (Array.isArray(person.addresses)) {\n  for (const addr of person.addresses) {\n    if (addr?.street) addressCandidates.push(addr.street);\n    const parts = [addr?.street, addr?.city, addr?.state, addr?.code].filter(Boolean);\n    if (parts.length > 1) addressCandidates.push(parts.join(\", \"));\n  }\n}\nconst uniqueCandidates = dedupe(addressCandidates);\n\nif (uniqueCandidates.length === 0) {\n  return [{ json: { skipped: true, reason: \"no_address\", person_id: person.id, person_name: person.name } }];\n}\n\nconst normalizedCandidates = dedupe(uniqueCandidates.map(v => normalize(v)));\nconst normalizedAddressCandidates = dedupe(uniqueCandidates.map(v => normalizeAddress(v)));\n\nconst matches = [];\nfor (const row of sheetRows) {\n  const fields = [\n    { key: \"street_address\", value: row.street_address || \"\" },\n    { key: \"property_key\",   value: row.property_key   || \"\" },\n  ];\n  let score = 0;\n  for (const field of fields) {\n    const nf  = normalize(field.value);\n    const naf = normalizeAddress(field.value);\n    if (naf && normalizedAddressCandidates.includes(naf)) score += field.key === \"street_address\" ? 120 : 90;\n    else if (nf && normalizedCandidates.includes(nf)) score += 70;\n    else { for (const c of uniqueCandidates) { const nc = normalize(c); if (nc && nf && (nf.includes(nc) || nc.includes(nf))) { score += 20; break; } } }\n  }\n  if (score > 0) matches.push({ ...row, score });\n}\nmatches.sort((a, b) => b.score - a.score);\nconst best = matches[0] || null;\n\nif (!best || best.score < 80) {\n  return [{ json: { skipped: true, reason: \"no_match\", person_id: person.id, person_name: person.name, address: uniqueCandidates[0], top_score: best?.score ?? 0 } }];\n}\nif (!best.cal_link) {\n  return [{ json: { skipped: true, reason: \"cal_link_blank\", person_id: person.id, person_name: person.name, matched_property: best.property_key } }];\n}\n\nreturn [{ json: {\n  skipped: false,\n  person_id: String(person.id),\n  person_name: person.name,\n  address: uniqueCandidates[0],\n  matched_property: best.property_key,\n  cal_link: best.cal_link,\n  match_score: best.score\n}}];\n"
      },
