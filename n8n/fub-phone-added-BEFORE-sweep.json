      "id": "816dba75-7e4e-44d7-9075-56ba8ffadc41",
      "name": "Test Mode - Testerson Only",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        464,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst person = $items(\"FUB - Get Person\")[0]?.json?.people?.[0] || {};\nconst textLogRows = $items(\"Read Text Log\").map(i => i.json || {});\nconst settingsRows = $items(\"Read Settings\").map(i => i.json || {});\n\nconst settings = {};\nfor (const row of settingsRows) {\n  if (row.key && row.value) settings[row.key] = row.value;\n}\n\nconst isTestMode = (person.firstName || \"\") === \"Test\";\nconst phone = person.phones?.[0]?.value;\nconst calLink = person.customCalLink;\n\nif (!phone) {\n  return [{ json: { skipped: true, reason: \"no_phone\", person_id: person.id, person_name: person.name } }];\n}\nif (!calLink) {\n  return [{ json: { skipped: true, reason: \"no_cal_link\", person_id: person.id, person_name: person.name } }];\n}\n\n// Only send to leads created within the last 4 days — except Test-mode\n// leads, which get reused indefinitely for end-to-end testing.\nconst created = person.created ? new Date(person.created) : null;\nconst fourDaysAgo = new Date(Date.now() - 4 * 24 * 60 * 60 * 1000);\nif (!isTestMode && (!created || created < fourDaysAgo)) {\n  return [{ json: { skipped: true, reason: \"lead_too_old\", person_id: person.id, person_name: person.name, created: person.created } }];\n}\n\n// Same Test-mode exception as the age check above — a reused test lead\n// will always have a prior \"already sent\" row otherwise.\nconst alreadySent = textLogRows.some(r => String(r.person_id) === String(person.id) && r.sent_at);\nif (!isTestMode && alreadySent) {\n  return [{ json: { skipped: true, reason: \"already_sent\", person_id: person.id, person_name: person.name } }];\n}\n\n// Normalize phone to E.164 — must be before enrichedCalLink\nconst digits = phone.replace(/\\D/g, \"\");\nconst toNumber = digits.length === 10 ? `+1${digits}` : `+${digits}`;\n\n// Build enriched cal link with FUB person ID and phone in metadata\nconst baseCalLink = (calLink.split('?')[0]).replace(/^(?!https?:\\/\\/)/, 'https://');\nconst enrichedCalLink = baseCalLink + '?metadata%5Bfub_person_id%5D=' + person.id + '&metadata%5Bphone%5D=' + encodeURIComponent(toNumber);\n\nconst greeting = \"Hello!\";\n\nconst addr = person.addresses?.[0];\nconst propertyAddress = addr?.street\n  ? [addr.street, addr.city, addr.state].filter(Boolean).join(\", \")\n  : \"the property\";\n\nconst template = settings.sms_template || \"\";\nconst applyLink = settings.apply_link || \"\";\nconst fromNumber = settings.from_number || \"\";\n\nconst message = template\n  .replace(/\\{\\{greeting\\}\\}/g, greeting)\n  .replace(/\\{\\{first_name\\}\\}/g, person.firstName || person.name || \"\")\n  .replace(/\\{\\{property_address\\}\\}/g, propertyAddress)\n  .replace(/\\{\\{cal_link\\}\\}/g, enrichedCalLink)\n  .replace(/\\{\\{apply_link\\}\\}/g, applyLink);\n\nreturn [{ json: {\n  skipped: false,\n  person_id: String(person.id),\n  person_name: person.name,\n  phone: toNumber,\n  from_number: fromNumber,\n  cal_link: calLink,\n  message: message,\n  sent_at: new Date().toISOString(),\n  enrichedCalLink: enrichedCalLink,\n  fub_person_id: String(person.id)\n}}];\n"
      },
