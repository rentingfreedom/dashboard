    {
      "parameters": {
        "jsCode": "\nfunction normalize(value) { return String(value ?? \"\").toLowerCase().replace(/[^a-z0-9]/g, \"\"); }\nfunction normalizeAddress(value) { return String(value ?? \"\").toLowerCase().replace(/\\b(apartment|apt|unit|suite|ste)\\b/g, \"\").replace(/\\b(street|st|road|rd|avenue|ave|drive|dr|court|ct|boulevard|blvd|lane|ln|circle|cir|place|pl|terrace|ter)\\b/g, \"\").replace(/[^a-z0-9]/g, \"\"); }\nfunction dedupe(values) { return [...new Set(values.map(v => String(v || \"\").trim()).filter(Boolean))]; }\n\nconst person = $items(\"FUB - Get Person\")[0]?.json?.people?.[0] || {};\nconst events  = $items(\"FUB - Get Events\")[0]?.json?.events || [];\nconst sheetRows = $items(\"Google Sheets - Read Properties\").map(i => i.json || {});\n\n// Filter: Zillow Rentals only\nif (person.source !== \"Zillow Rentals\") {\n  return [{ json: { skipped: true, reason: \"not_zillow\", person_id: person.id, person_name: person.name, source: person.source } }];\n}\n\n// Find Property Inquiry event with a street address\nconst propEvent = events.find(e => e.type === \"Property Inquiry\" && e.property?.street);\nif (!propEvent) {\n  return [{ json: { skipped: true, reason: \"no_property_inquiry\", person_id: person.id, person_name: person.name } }];\n}\n\nconst prop = propEvent.property;\nconst addressCandidates = dedupe([\n  prop.street,\n  [prop.street, prop.city, prop.state, prop.code].filter(Boolean).join(\", \")\n]);\n\nconst normalizedCandidates = dedupe(addressCandidates.map(v => normalize(v)));\nconst normalizedAddressCandidates = dedupe(addressCandidates.map(v => normalizeAddress(v)));\n\nconst matches = [];\nfor (const row of sheetRows) {\n  const fields = [\n    { key: \"street_address\", value: row.street_address || \"\" },\n    { key: \"property_key\",   value: row.property_key   || \"\" },\n  ];\n  let score = 0;\n  for (const field of fields) {\n    const nf  = normalize(field.value);\n    const naf = normalizeAddress(field.value);\n    if (naf && normalizedAddressCandidates.includes(naf)) score += field.key === \"street_address\" ? 120 : 90;\n    else if (nf && normalizedCandidates.includes(nf)) score += 70;\n    else { for (const c of addressCandidates) { const nc = normalize(c); if (nc && nf && (nf.includes(nc) || nc.includes(nf))) { score += 20; break; } } }\n  }\n  if (score > 0) matches.push({ ...row, score });\n}\nmatches.sort((a, b) => b.score - a.score);\nconst best = matches[0] || null;\n\nif (!best || best.score < 80) {\n  return [{ json: { skipped: true, reason: \"no_match\", person_id: person.id, person_name: person.name, address: prop.street, top_score: best?.score ?? 0 } }];\n}\nif (!best.cal_link) {\n  return [{ json: { skipped: true, reason: \"cal_link_blank\", person_id: person.id, person_name: person.name, matched_property: best.property_key } }];\n}\n\nreturn [{ json: {\n  skipped: false,\n  person_id: String(person.id),\n  person_name: person.name,\n  prop_street: prop.street,\n  prop_city: prop.city || \"\",\n  prop_state: prop.state || \"\",\n  prop_code: prop.code || \"\",\n  matched_property: best.property_key,\n  cal_link: best.cal_link,\n  match_score: best.score\n}}];\n"
      },
