    {
      "id": "pln-read-settings",
      "name": "Read Settings",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        224,
        200
      ],
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1wo_G5EVfT80lUd-2FFi_TVrCQuiXTPrpdVIG1Tr_iuw",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "B1NdndfWsQ3pFzEV",
          "name": "Google Sheets account"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 15000
    },
    {
      "id": "pln-build-messages",
      "name": "Build Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        200
      ],
      "parameters": {
        "jsCode": "// PROPERTY_LEASED_NOTIFY_MARKER\n// One item in (via 'Read Settings', which this node ignores as its own\n// input), one item out. The webhook body is read by NAMED reference, not\n// $json/$input -- this node's immediate input is Settings' ~60 rows, not the\n// webhook payload (gotcha 19 / gotcha 12).\nconst body = ($('Webhook').first().json || {}).body || {};\n\nconst settingsRows = $('Read Settings').all().map((i) => i.json);\nconst settings = {};\nfor (const r of settingsRows) {\n  const k = String(r.key ?? '').trim();\n  if (k) settings[k] = String(r.value ?? '').trim();\n}\n\nconst personId = String(body.personId || '').trim();\nconst phone = String(body.phone || '').trim();\nconst email = String(body.email || '').trim();\nconst propertyAddress = String(body.propertyAddress || body.propertyKey || 'the property').trim();\nconst isBooked = String(body.messageState || '').trim().toLowerCase() === 'booked';\n\n// SMS_FOOTER_MARKER -- identical helper to every other lead-facing build\n// node in this estate, copied verbatim rather than re-derived.\nconst smsFooter = String(settings.sms_footer || '').trim();\nconst withFooter = (m) => {\n  const b = String(m ?? '');\n  if (!smsFooter || !b || b.includes(smsFooter)) return b;\n  return b + '\\n\\n' + smsFooter;\n};\n\nconst smsTemplate = settings.property_leased_sms_template || '';\nconst smsCancelNote = settings.property_leased_sms_cancel_note || '';\nconst smsRaw = smsTemplate\n  .replace(/\\{\\{property_address\\}\\}/g, propertyAddress)\n  .replace(/\\{\\{cancel_note\\}\\}/g, isBooked ? smsCancelNote : '');\nconst smsMessage = withFooter(smsRaw);\n\nconst emailSubjectTemplate = settings.property_leased_email_subject || '';\nconst emailBodyTemplate = settings.property_leased_email_body || '';\nconst emailCancelNote = isBooked ? (settings.property_leased_email_cancel_note || '') : '';\n\nconst emailSubject = emailSubjectTemplate.replace(/\\{\\{property_address\\}\\}/g, propertyAddress);\nconst emailBody = emailBodyTemplate\n  .replace(/\\{\\{property_address\\}\\}/g, propertyAddress)\n  .replace(/\\{\\{cancel_note\\}\\}/g, emailCancelNote);\n\nif (!smsTemplate) console.log('[property-leased-notify] property_leased_sms_template is empty -- SMS body will be blank');\nif (!emailBodyTemplate) console.log('[property-leased-notify] property_leased_email_body is empty -- email body will be blank');\n\nreturn [{ json: {\n  personId,\n  phone,\n  email,\n  from_number: settings.from_number || '',\n  propertyAddress,\n  messageState: body.messageState || '',\n  message: smsMessage,\n  subject: emailSubject,\n  emailBody,\n} }];"
      }
    },
    {
      "id": "pln-has-phone",
      "name": "Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ !!$json.phone }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
