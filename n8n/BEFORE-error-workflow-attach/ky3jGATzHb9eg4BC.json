    },
    {
      "id": "tt-extract-person",
      "name": "Extract Person",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        208
      ],
      "parameters": {
        "jsCode": "const people = $(\"FUB - Find Test Test9\").first().json.people || [];\nif (!people.length) {\n  return [{ json: { found: false } }];\n}\nconst person = people[0];\nreturn [{ json: {\n  found: true,\n  person_id: String(person.id),\n  first_name: person.firstName || \"\",\n  last_name: person.lastName || \"\",\n  uri: \"https://api.followupboss.com/v1/people?id=\" + person.id,\n} }];"
      }
    },
    {
      "id": "tt-person-found",
      "name": "Person Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        448,
        208
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.found }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "tt-read-log",
      "name": "Read Identity Verifications",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        672,
        112
      ],
      "alwaysOutputData": true,
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "1wo_G5EVfT80lUd-2FFi_TVrCQuiXTPrpdVIG1Tr_iuw",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Identity_Verifications",
          "mode": "name"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "B1NdndfWsQ3pFzEV",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "tt-find-matching-rows",
      "name": "Find Matching Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        112
      ],
      "parameters": {
        "jsCode": "const personId = $(\"Extract Person\").first().json.person_id;\nconst rows = $items(\"Read Identity Verifications\").map(i => i.json || {});\n\nconst matches = rows.filter(r => String(r.lead_id) === String(personId) && r.row_number);\n\nreturn matches.map(r => ({ json: { row_number: r.row_number } }));"
      }
    },
    {
      "id": "tt-clear-row",
      "name": "Clear Old Row Lead ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        112
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/1wo_G5EVfT80lUd-2FFi_TVrCQuiXTPrpdVIG1Tr_iuw/values/Identity_Verifications!B' + $json.row_number + '?valueInputOption=USER_ENTERED' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ values: [[ 'reset-' + Date.now() ]] }) }}",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "B1NdndfWsQ3pFzEV",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "tt-trigger-gate",
      "name": "Trigger Gate Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://automation.rentingfreedom.com/webhook/phone-added-send-text",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ eventId: 'manual-test-' + Date.now(), event: 'peopleUpdated', resourceIds: [Number($('Extract Person').first().json.person_id)], uri: $('Extract Person').first().json.uri }) }}",
        "options": {}
      }
    },
    {
