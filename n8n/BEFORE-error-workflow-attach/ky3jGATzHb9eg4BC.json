      ],
      "parameters": {
        "url": "https://api.followupboss.com/v1/people?firstName=Test&lastName=Test9&fields=allFields",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-System",
