    {
      "id": "idv-build-sms",
      "name": "Build Verification SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        112
      ],
      "parameters": {
        "jsCode": "const guard = $(\"Check Guards\").first().json;\nconst session = $json;\n\nconst template = guard.identity_sms_template ||\n  \"Hi {{first_name}}, before we can schedule your showing we need to quickly verify your ID. Please complete this short verification: {{verify_link}}\";\n\nconst message = template\n  .replace(/\\{\\{first_name\\}\\}/g, guard.first_name || \"\")\n  .replace(/\\{\\{verify_link\\}\\}/g, session.url || \"\");\n\nreturn [{ json: {\n  message,\n  phone: guard.phone,\n  from_number: guard.from_number,\n  session_id: session.sessionId,\n  person_id: guard.person_id,\n  person_name: guard.person_name,\n  original_webhook_body: guard.original_webhook_body,\n  sent_at: new Date().toISOString(),\n} }];"
      }
    },
