        "options": {}
      },
      "id": "19602a41-eb3e-4ba0-afdc-62179f0003ef"
    },
    {
      "name": "Build SMS (Cron)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "jsCode": "\nfunction fmtShowingSlot(showingTimeISO) {\n  const start = new Date(showingTimeISO);\n  const end   = new Date(start.getTime() + 15 * 60 * 1000);\n  const timeFmt = new Intl.DateTimeFormat('en-US', {\n    timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit', hour12: true\n  });\n  const dateFmt = new Intl.DateTimeFormat('en-US', {\n    timeZone: 'America/New_York', month: 'short', day: 'numeric', year: 'numeric'\n  });\n  return 'Valid from ' + timeFmt.format(start) + ' through ' + timeFmt.format(end) + ', ' + dateFmt.format(start);\n}\n\nfunction fmtTime(iso) {\n  try {\n    return new Intl.DateTimeFormat('en-US', {\n      timeZone: 'America/New_York',\n      weekday: 'short', month: 'short', day: 'numeric',\n      hour: 'numeric', minute: '2-digit', hour12: true\n    }).format(new Date(iso));\n  } catch(e) { return iso; }\n}\n\nconst row    = $('Calc Code Window (Cron)').first().json;\nconst code   = $('Populife - Generate Code (Cron)').first().json.data?.keyboardPwd ?? '';\nconst codeId = String($('Populife - Generate Code (Cron)').first().json.data?.keyboardPwdId ?? '');\n\nconst validWindow = fmtShowingSlot(row.showing_time);\n\nconst message = row.smsTemplate\n  .replace('{{first_name}}',   (row.person_name ?? '').split(' ')[0] ?? '')\n  .replace('{{name}}',         row.person_name ?? '')\n  .replace('{{address}}',      row.property_address ?? row.property_key ?? '')\n  .replace('{{date}}',         fmtTime(row.showing_time))\n  .replace('{{code}}',         code)\n  .replace('{{valid_window}}', validWindow)\n  .replace('{{start}}',        row.startDate ?? '')\n  .replace('{{end}}',          row.endDate ?? '');\n\nreturn [{ json: {\n  ...row,\n  code, codeId, message,\n  from_number: row.fromNumber,\n  phone: row.person_phone,\n  sent_at: new Date().toISOString(),\n} }];\n"
      },
      "id": "b9333055-2c60-4d39-9268-ddbd14ebf205"
    },
