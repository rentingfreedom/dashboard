    {
      "name": "Calc Code Window (Cron)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "\nfunction calcWindow(showingTimeISO, availableBeforeMinutes) {\n  const dt = new Date(showingTimeISO);\n  const pad = n => String(n).padStart(2, '0');\n\n  const effectiveStart = new Date(dt.getTime() - availableBeforeMinutes * 60 * 1000);\n  const startUtc = new Date(effectiveStart);\n  startUtc.setUTCMinutes(0, 0, 0);\n\n  const showingFloor = new Date(dt);\n  showingFloor.setUTCMinutes(0, 0, 0);\n  const endUtc = new Date(showingFloor.getTime() + 3600 * 1000);\n\n  const fmt = d => `${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())} ${pad(d.getUTCHours())}:00`;\n  return { startDate: fmt(startUtc), endDate: fmt(endUtc), tzOffset: '0' };\n}\n\nconst row = $('Find Ready Showings').first().json;\nconst settings = {};\n$('Read Settings (Cron)').all().forEach(i => {\n  if (i.json.key && i.json.value) settings[i.json.key] = i.json.value;\n});\n\nconst appKey    = settings.populife_app_key ?? '';\nconst appSecret = settings.populife_app_secret ?? '';\nif (!appKey || !appSecret) throw new Error('Populife credentials missing from Settings sheet');\n\nconst availableBeforeMinutes = parseInt(settings.available_before_minutes || '0');\nconst { startDate, endDate, tzOffset } = calcWindow(row.showing_time, availableBeforeMinutes);\n\nconst populifeLockId = row.populife_lock_id ?? row.populifeLockId ?? '';\nif (!populifeLockId) throw new Error('populife_lock_id missing on row ' + row.booking_uid);\n\n// Pass SMS-related settings through for downstream Build SMS\nconst smsTemplate = settings.access_code_sms_template ?? 'Your access code for {{address}} is: {{code}}';\nconst fromNumber  = settings.from_number ?? '';\n\nreturn [{ json: {\n  ...row,\n  appKey, appSecret,\n  startDate, endDate, tzOffset,\n  populifeLockId,\n  smsTemplate, fromNumber,\n} }];\n"
      },
      "id": "1e65083b-2c54-4241-96c3-e1f9af1dc503"
    },
