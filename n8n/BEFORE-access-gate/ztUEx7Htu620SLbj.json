    {
      "name": "Find Ready Showings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "\nconst now = Date.now();\nconst oneHour = 60 * 60 * 1000;\nconst rows = $input.all().map(i => i.json);\n\n// ── ACCESS_GATE_MARKER: test gate ──────────────────────────────────────────────\n// Reads the is_test verdict stamped onto the row by the Booking Handler's\n// 'Build Showing Row', which is where the FUB person is actually in hand.\n// Do NOT re-derive this from person_name — that is the cal.com attendee\n// name, which is whatever the tester typed, not the FUB lead's name.\n// Sheets coerces \"true\" -> boolean TRUE on write (gotcha 14), so compare\n// as a lowercased string. Blank (rows appended before the gate) = not test.\nconst isTestShowing = (r) => String(r.is_test ?? '').trim().toLowerCase() === 'true';\n\nconst ready = rows.filter(r => {\n  if (!isTestShowing(r)) return false; // ACCESS_GATE_MARKER\n  if (r.status !== 'scheduled') return false;\n  if (!r.showing_time) return false;\n  const showingMs = new Date(r.showing_time).getTime();\n  // Window: showing is between now and 1h from now (send when T-60min to T)\n  return showingMs >= now && showingMs <= now + oneHour;\n});\n\nif (ready.length === 0) return [{ json: { hasReady: false } }];\nreturn ready.map(r => ({ json: { ...r, hasReady: true } }));\n"
      },
      "id": "da3ab4ee-55b1-485f-b504-07d67814ba38"
    },
