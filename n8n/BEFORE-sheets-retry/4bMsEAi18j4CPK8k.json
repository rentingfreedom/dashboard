    {
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Compute Occupancy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "jsCode": "// DoorLoop occupancy → Properties sheet.\n//\n// Rule: a unit is occupied if its id appears in the units[] array of any lease\n// with calculatedStatus == \"ACTIVE\". Each sheet row maps to exactly one DoorLoop\n// UNIT id (stored in doorloop_property_id by scripts/doorloop-match.mjs), so a\n// row's status is just that unit's occupancy — no roll-up needed.\n\nconst unitsResp = $('Fetch Units').first().json;\nconst leasesResp = $('Fetch Active Leases').first().json;\nconst rows = $('Read Properties').all().map((i) => i.json);\n\nconst units = unitsResp.data ?? [];\nconst leases = leasesResp.data ?? [];\n\n// Guard: page_size is 1000 and the portfolio is ~70 units, so a truncated page\n// means the portfolio outgrew a single page. Fail loudly rather than silently\n// marking every unpaged unit vacant.\nif ((unitsResp.total ?? units.length) > units.length) {\n  throw new Error(`Units response truncated: total=${unitsResp.total} but only ${units.length} returned. Add pagination.`);\n}\nif ((leasesResp.total ?? leases.length) > leases.length) {\n  throw new Error(`Leases response truncated: total=${leasesResp.total} but only ${leases.length} returned. Add pagination.`);\n}\nif (units.length === 0) {\n  throw new Error('DoorLoop returned zero units — refusing to mark the whole portfolio vacant.');\n}\n\n// Sheets returns numbers as numbers; ids must be compared as strings.\nconst occupiedUnitIds = new Set();\nfor (const lease of leases) {\n  if (String(lease.calculatedStatus ?? '').toUpperCase() !== 'ACTIVE') continue;\n  for (const unitId of lease.units ?? []) occupiedUnitIds.add(String(unitId));\n}\n\nconst knownUnitIds = new Set(units.map((u) => String(u.id)));\n\nconst now = new Date().toISOString();\nconst out = [];\nconst stale = [];\nlet overridden = 0;\nlet unmapped = 0;\n\nfor (const row of rows) {\n  const propertyKey = String(row.property_key ?? '').trim();\n  const dlUnitId = String(row.doorloop_property_id ?? '').trim();\n\n  if (!propertyKey) continue;\n\n  // No DoorLoop counterpart — status stays whatever a human set. Never touched.\n  if (!dlUnitId) {\n    unmapped += 1;\n    continue;\n  }\n\n  // Mapping points at a unit DoorLoop no longer returns (deleted/archived).\n  // Skip rather than guess: writing 'vacant' here would be a silent data loss.\n  if (!knownUnitIds.has(dlUnitId)) {\n    stale.push(`${propertyKey} → ${dlUnitId}`);\n    continue;\n  }\n\n  const doorloopStatus = occupiedUnitIds.has(dlUnitId) ? 'occupied' : 'vacant';\n  const override = String(row.status_override ?? '').trim().toLowerCase();\n  if (override) overridden += 1;\n\n  out.push({\n    json: {\n      property_key: propertyKey,\n      // Always written: what DoorLoop actually reports, so the dashboard can show\n      // the real value alongside an override.\n      doorloop_status: doorloopStatus,\n      doorloop_synced_at: now,\n      // An active admin override wins. We rewrite it to its own value rather than\n      // omitting the field, so the Sheets node can't blank the cell.\n      status: override || doorloopStatus,\n    },\n  });\n}\n\nconsole.log(`[doorloop-sync] units=${units.length} activeLeases=${leases.length} occupiedUnits=${occupiedUnitIds.size}`);\nconsole.log(`[doorloop-sync] writing=${out.length} overridden=${overridden} unmapped=${unmapped} stale=${stale.length}`);\nif (stale.length) {\n  console.log(`[doorloop-sync] STALE MAPPINGS (doorloop_property_id not found in DoorLoop): ${stale.join(', ')}`);\n}\n\nif (out.length === 0) {\n  throw new Error('No rows to write — every row is unmapped or stale. Check doorloop_property_id in the Properties sheet.');\n}\n\nreturn out;\n"
      }
    },
