    {
      "id": "res-find-row",
      "name": "Find Verification Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        300
      ],
      "parameters": {
        "jsCode": "const body = $(\"Webhook\").first().json.body || {};\nconst rows = $items(\"Read Identity Verifications\").map(i => i.json || {});\nconst settingsRows = $items(\"Read Settings\").map(i => i.json || {});\n\nconst settings = {};\nfor (const row of settingsRows) {\n  if (row.key && row.value !== undefined) settings[row.key] = row.value;\n}\n\nconst match = rows.find(r => String(r.session_id) === String(body.session_id));\n\nif (!match) {\n  return [{ json: { found: false, session_id: body.session_id || \"\" } }];\n}\n\n// Google Sheets returns numbers as numbers — phone can come back with the\n// leading \"+\" stripped. Repair it defensively rather than trust the type.\nlet phone = String(match.phone || \"\");\nif (phone && !phone.startsWith(\"+\")) phone = \"+\" + phone;\n\nreturn [{ json: {\n  found: true,\n  row_number: match.row_number,\n  session_id: String(body.session_id || \"\"),\n  lead_id: match.lead_id || \"\",\n  lead_name: match.lead_name || \"\",\n  phone,\n  sent_at: match.sent_at || \"\",\n  original_webhook_body: match.original_webhook_body || \"\",\n  status: body.status || \"\",\n  error_code: body.error_code || \"\",\n  error_reason: body.error_reason || \"\",\n  // Idempotency guard: this is the row's OWN stored status from the sheet\n  // (set by a prior successful run of this workflow), not the incoming\n  // webhook's status. If a redelivered/duplicate webhook comes in for a\n  // session that's already been fully processed, short-circuit before\n  // re-sending any SMS.\n  already_resolved: match.status === \"verified\" || match.status === \"failed\",\n  from_number: settings.from_number || \"\",\n  failed_template: settings.identity_failed_sms_template ||\n    \"Hi {{first_name}}, we weren\\'t able to verify your ID automatically. Someone from our team will follow up with you shortly.\",\n} }];"
      }
    },
