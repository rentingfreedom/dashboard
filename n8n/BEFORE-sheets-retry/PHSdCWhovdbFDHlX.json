    {
      "id": "res-build-failed-sms",
      "name": "Build Failed SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "jsCode": "const guard = $(\"Find Verification Row\").first().json;\nconst firstName = (guard.lead_name || \"\").split(\" \")[0] || guard.lead_name || \"\";\n\nconst message = (guard.failed_template || \"\")\n  .replace(/\\{\\{first_name\\}\\}/g, firstName);\n\nreturn [{ json: {\n  message,\n  phone: guard.phone,\n  from_number: guard.from_number,\n} }];"
      }
